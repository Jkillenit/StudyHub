# Optional: copy to .env in this folder (for dev) or set as Windows system environment variables.
# The app loads .env from the project root when you run the built desktop app from source; the
# packaged .exe may not ship .env — use the in-app "AI assistant" to save the key instead.

# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

